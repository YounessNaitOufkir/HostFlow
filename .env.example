# Copy to .env.local and fill in. Never commit the filled-in file.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Absolute URL used in email and Telegram links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Scheduled jobs ----
# The cron routes refuse to run without this, rather than defaulting to open.
CRON_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Signs the deep link that ties a Telegram chat to an account.
TELEGRAM_LINK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ---- Google sign-in and calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sentry ----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- End-to-end tests ----
# An account the Playwright suite signs in as.
E2E_EMAIL=
E2E_PASSWORD=
